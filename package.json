{
  "name": "@local/dsh-rain-ocean-skin",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "HD looping rain-ocean video skin: a Blender-rendered 1080p night rain sea with a buoy tower, used as the window background.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "native-dist/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
